---
import { getCourseBenefits } from "@/lib/utils/course";
import type { CourseBenefitsData } from "@/types/course";

export interface Props {
  benefits?: CourseBenefitsData;
}

const { benefits = getCourseBenefits() } = Astro.props;
---

<section
  id="vantaggi-corso"
  aria-labelledby="course-benefits-heading"
  class="bg-slate-50 py-16 sm:py-20 border-b border-slate-200/80 scroll-mt-20"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {benefits.kicker && (
      <span class="font-heading text-xs font-semibold uppercase tracking-widest text-referee-gold mb-2 sm:mb-3 block text-center">
        {benefits.kicker}
      </span>
    )}

    <div class="flex items-center gap-2 sm:gap-4 mb-3 sm:mb-4">
      <div
        class="h-[2px] bg-[#004b97] flex-1 min-w-5 sm:min-w-8 shrink-0"
        aria-hidden="true"
      ></div>
      <h2
        id="course-benefits-heading"
        class="font-heading font-extrabold text-xl sm:text-2xl lg:text-3xl text-slate-900 tracking-tight text-balance text-center uppercase"
      >
        {benefits.title}
      </h2>
      <div
        class="h-[2px] bg-[#004b97] flex-1 min-w-5 sm:min-w-8 shrink-0"
        aria-hidden="true"
      ></div>
    </div>

    <p class="font-sans text-base text-slate-700 leading-relaxed max-w-3xl mb-10 sm:mb-12 text-pretty text-center mx-auto">
      {benefits.lead}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      {benefits.items.map((benefit) => (
        <div class="border-t-2 border-slate-900 pt-4">
          <h3 class="font-heading text-lg sm:text-xl font-bold text-slate-900 tracking-tight leading-snug">
            {benefit.title}
          </h3>
          <p class="font-sans text-sm sm:text-base text-slate-700 leading-relaxed mt-2.5 text-pretty">
            {benefit.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
