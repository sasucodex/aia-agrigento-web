---
import { Image } from "astro:assets";
import heroRaduno from "@/assets/images/hero-raduno.jpg";
import aiaFigcLogo from "@/assets/logos/logo-aia-figc.png";
import { PRIMARY_CTA } from "@/constants/navigation";
---

<section
  aria-labelledby="hero-heading"
  class="relative min-h-[500px] sm:min-h-[600px] lg:min-h-[640px] flex items-center justify-center overflow-hidden bg-slate-950"
>
  <Image
    src={heroRaduno}
    alt="Arbitri e dirigenti della Sezione AIA di Agrigento durante il raduno stagionale"
    format="webp"
    widths={[640, 1024, 1536, 1920]}
    sizes="100vw"
    quality={82}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="object-cover object-center w-full h-full absolute inset-0 select-none pointer-events-none"
  />

  <div
    aria-hidden="true"
    class="absolute inset-0 bg-gradient-to-b from-slate-950/75 via-slate-950/65 to-slate-950/85"
  >
  </div>

  <div class="relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 lg:py-28 flex flex-col items-center text-center">
    <div class="flex items-center justify-center gap-4 sm:gap-6">
      <img
        src="/favicon.svg"
        alt="Stemma AIA Sezione di Agrigento"
        width="80"
        height="80"
        loading="eager"
        decoding="async"
        class="h-16 w-16 sm:h-20 sm:w-20 object-contain drop-shadow-md"
      />
      <span aria-hidden="true" class="h-10 sm:h-12 w-px bg-white/25"></span>
      <Image
        src={aiaFigcLogo}
        alt="Associazione Italiana Arbitri - AIA FIGC"
        width={160}
        height={160}
        format="webp"
        loading="eager"
        decoding="async"
        class="h-16 w-16 sm:h-20 sm:w-20 object-contain drop-shadow-md"
      />
    </div>

    <div class="w-full max-w-3xl flex items-center justify-center gap-3 sm:gap-5 mt-5 mb-2">
      <span aria-hidden="true" class="hidden sm:block h-[2px] flex-1 max-w-16 bg-[#004b97]"></span>
      <h1
        id="hero-heading"
        class="font-heading font-extrabold text-2xl sm:text-5xl lg:text-6xl tracking-tight text-white uppercase leading-[1.1] text-balance drop-shadow-sm"
      >
        Sezione di Agrigento
      </h1>
      <span aria-hidden="true" class="hidden sm:block h-[2px] flex-1 max-w-16 bg-[#004b97]"></span>
    </div>

    <p class="font-heading text-xs sm:text-sm font-semibold uppercase tracking-widest text-referee-gold mb-8">
      Associazione Italiana Arbitri — F.I.G.C.
    </p>

    <a
      href={PRIMARY_CTA.href}
      class="w-full sm:w-auto inline-flex items-center justify-center bg-referee-gold hover:brightness-95 active:scale-[0.98] text-slate-950 font-heading font-extrabold text-sm sm:text-base uppercase tracking-wider px-8 py-4 rounded-sm shadow-lg transition-all duration-200 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
    >
      Diventa Arbitro
    </a>
  </div>
</section>
