---
import { getStatItems } from "@/lib/utils/stats";
import type { StatMetricItem } from "@/types/stats";

export interface Props {
  items?: StatMetricItem[];
}

const { items = getStatItems() } = Astro.props;
---

<section
  aria-label="Numeri e traguardi della Sezione"
  class="bg-white border-b border-slate-200/80"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-y-6 gap-x-4 sm:gap-0 sm:divide-x sm:divide-slate-200">
      {items.map((item) => (
        <div class="flex flex-col items-center text-center px-2 sm:px-6">
          <dd class="order-1 font-heading font-extrabold text-2xl sm:text-3xl lg:text-4xl text-[#004b97] tabular-nums tracking-tight">
            {item.value}
          </dd>
          <dt class="order-2 font-sans text-xs sm:text-sm font-semibold text-slate-600 uppercase tracking-wider mt-1">
            {item.label}
          </dt>
        </div>
      ))}
    </dl>
  </div>
</section>
