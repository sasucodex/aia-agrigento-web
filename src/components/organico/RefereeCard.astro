---
import type { Associato } from "@/types/organico";

export interface Props {
  associato: Associato;
}

const { associato } = Astro.props;
---

<div class="bg-white border border-slate-200 rounded-sm shadow-xs overflow-hidden text-center hover:border-slate-300 transition-colors duration-200 flex flex-col">
  <div class="aspect-[4/5] w-full bg-slate-50 overflow-hidden relative flex items-center justify-center">
    {associato.foto ? (
      <img
        src={associato.foto}
        alt={`${associato.cognome} ${associato.nome}`}
        width="720"
        height="900"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover object-top"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
    ) : null}

    <div
      class={`w-full h-full flex-col items-center justify-center p-6 bg-slate-100 ${associato.foto ? "hidden" : "flex"}`}
    >
      <img
        src="/favicon.svg"
        alt="AIA Agrigento"
        width="96"
        height="96"
        loading="lazy"
        decoding="async"
        class="h-20 sm:h-24 w-auto opacity-40 grayscale object-contain"
      />
    </div>
  </div>

  <div class="p-3 sm:p-4 flex flex-col flex-1 justify-between bg-white">
    <div>
      {associato.isBenemerito && (
        <p class="font-heading font-bold text-[11px] uppercase tracking-wider text-referee-gold mb-1">
          Arbitro Benemerito
        </p>
      )}

      <h3 class="font-heading font-bold text-xs sm:text-base text-slate-900 leading-snug uppercase min-h-[2.5rem] sm:min-h-[2.75rem] flex items-center justify-center text-balance">
        {associato.cognome} {associato.nome}
      </h3>
      <p class="font-sans text-[11px] sm:text-xs text-slate-600 mt-0.5">
        {associato.ruolo}
      </p>
    </div>

    <div class="mt-2.5 pt-2 border-t border-slate-100">
      <p class="font-heading font-bold text-xs uppercase tracking-wider text-[#004b97]">
        {associato.organoTecnico}
      </p>
    </div>
  </div>
</div>
