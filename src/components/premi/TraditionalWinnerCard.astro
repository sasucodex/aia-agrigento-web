---
import type { TraditionalWinner } from "@/types/awards";

export interface Props {
  winner: TraditionalWinner;
}

const { winner } = Astro.props;
const hasImage = Boolean(winner.image);
---

<article class="bg-white border border-slate-200 rounded-sm overflow-hidden flex flex-col shadow-xs hover:border-slate-300 transition-colors duration-200">
  <div class="aspect-square w-full overflow-hidden bg-slate-100 relative flex items-center justify-center">
    {hasImage ? (
      <img
        src={winner.image!}
        alt={`Ritratto di ${winner.name}, premiato nella stagione ${winner.season}`}
        width="400"
        height="400"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover object-top"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
    ) : null}

    <div
      class={`w-full h-full flex-col items-center justify-center p-6 bg-slate-100 ${hasImage ? "hidden" : "flex"}`}
    >
      <img
        src="/favicon.svg"
        alt="Stemma AIA Sezione di Agrigento"
        width="80"
        height="80"
        loading="lazy"
        decoding="async"
        class="h-16 sm:h-20 w-auto object-contain grayscale opacity-35"
      />
    </div>
  </div>

  <div class="p-2 sm:p-4 text-center flex-1 flex flex-col justify-center bg-white">
    <h4
      class="font-heading font-semibold text-xs sm:text-base leading-snug text-slate-900 text-balance break-words"
      title={winner.name}
    >
      {winner.name}
    </h4>
    <p class="font-sans text-[11px] sm:text-xs text-slate-500 font-medium tabular-nums mt-1">
      Stagione {winner.season}
    </p>
  </div>
</article>
