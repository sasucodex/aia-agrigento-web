---
import {
  getNazionaleExternalDocument,
  getSezionaleDocumentsByCluster,
} from "@/lib/utils/services";
import type { DocumentCluster, ServiceDocument } from "@/types/services";

export interface Props {
  clusters?: {
    id: DocumentCluster;
    label: string;
    documents: ServiceDocument[];
  }[];
  nazionaleDoc?: ServiceDocument;
}

const {
  clusters = getSezionaleDocumentsByCluster(),
  nazionaleDoc = getNazionaleExternalDocument(),
} = Astro.props;
---

<section
  id="modulistica"
  aria-labelledby="modulistica-section-heading"
  class="bg-white border-b border-slate-200/80 scroll-mt-20"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="flex items-center gap-2 sm:gap-4 mb-8 sm:mb-10">
      <div
        class="h-[2px] bg-[#004b97] flex-1 min-w-5 sm:min-w-8 shrink-0"
        aria-hidden="true"
      ></div>
      <h2
        id="modulistica-section-heading"
        class="font-heading font-extrabold text-xl sm:text-3xl lg:text-4xl text-slate-900 tracking-tight text-balance text-center uppercase"
      >
        Modulistica & Referti Gara
      </h2>
      <div
        class="h-[2px] bg-[#004b97] flex-1 min-w-5 sm:min-w-8 shrink-0"
        aria-hidden="true"
      ></div>
    </div>

    {nazionaleDoc && (
      <div class="border border-blue-200 bg-blue-50/40 p-5 sm:p-6 rounded-sm shadow-xs mb-8 sm:mb-10">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5 lg:gap-8">
          <div class="min-w-0 flex-1">
            <h3 class="font-heading text-lg sm:text-xl font-bold text-slate-900 tracking-tight leading-snug">
              {nazionaleDoc.title}
            </h3>
            <p class="font-sans text-sm sm:text-base text-slate-700 leading-relaxed mt-2 max-w-prose text-pretty">
              {nazionaleDoc.description}
            </p>
          </div>

          <div class="shrink-0">
            <a
              href={nazionaleDoc.previewUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-2 bg-[#004b97] hover:bg-blue-800 active:scale-[0.98] text-white font-heading font-bold text-xs uppercase tracking-wider px-5 py-3 rounded-sm shadow-xs transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004b97]"
            >
              <span>Accedi all&apos;Area Riservata Referti AIA FIGC</span>
              <svg
                class="w-4 h-4 shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M7 17L17 7M17 7H7M17 7V17"
                />
              </svg>
            </a>
          </div>
        </div>
      </div>
    )}

    <h3 class="font-heading font-bold text-base sm:text-lg text-slate-900 tracking-tight mb-6">
      Modulistica Sezionale Ufficiale
    </h3>

    <div class="space-y-8 sm:space-y-10">
      {clusters.map((cluster) => (
        <div>
          <h4 class="font-heading text-xs font-bold uppercase tracking-widest text-[#004b97] mb-3 pb-1.5 border-b border-slate-200">
            {cluster.label}
          </h4>
          <ul class="divide-y divide-slate-100 bg-white border border-slate-200 rounded-sm">
            {cluster.documents.map((doc) => (
              <li class="p-4 sm:p-5 hover:bg-slate-50/60 transition-colors duration-150 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="min-w-0 flex-1">
                  <a
                    href={doc.previewUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-heading font-semibold text-sm sm:text-base text-slate-900 tracking-tight hover:text-[#004b97] hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004b97]"
                  >
                    {doc.title}
                  </a>
                  <p class="font-sans text-xs sm:text-sm text-slate-600 leading-relaxed mt-1 max-w-prose text-pretty">
                    {doc.description}
                  </p>
                </div>

                <div class="shrink-0">
                  <a
                    href={doc.previewUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    download={doc.fileName}
                    class="w-full sm:w-auto min-h-[38px] inline-flex items-center justify-center gap-2 px-3.5 py-2 rounded-sm bg-[#004b97] hover:bg-blue-800 active:scale-[0.98] text-white font-heading font-bold text-xs uppercase tracking-wider shadow-xs transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004b97]"
                  >
                    <span>Scarica</span>
                    <svg
                      class="w-3.5 h-3.5 shrink-0"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                      />
                    </svg>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
