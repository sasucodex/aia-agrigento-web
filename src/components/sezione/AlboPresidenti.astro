---
import PresidentCard from "@/components/sezione/PresidentCard.astro";
import { getPresidents } from "@/lib/utils/presidents";
import type { President } from "@/types/presidents";

export interface Props {
  presidents?: President[];
}

const { presidents = getPresidents() } = Astro.props;
---

<section
  aria-labelledby="albo-presidenti-heading"
  class="bg-slate-50 border-b border-slate-100"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="flex items-center gap-2 sm:gap-4 mb-8 sm:mb-10">
      <div class="h-[2px] bg-[#004b97] flex-1" aria-hidden="true"></div>
      <h2
        id="albo-presidenti-heading"
        class="font-heading font-extrabold text-lg sm:text-2xl lg:text-3xl text-slate-900 tracking-tight text-balance text-center sm:whitespace-nowrap uppercase"
      >
        Albo dei presidenti
      </h2>
      <div class="h-[2px] bg-[#004b97] flex-1" aria-hidden="true"></div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-6">
      {presidents.map((president) => (
        <PresidentCard president={president} />
      ))}
    </div>
  </div>
</section>
