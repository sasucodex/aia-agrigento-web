---
import type { President } from "@/types/presidents";

export interface Props {
  president: President;
}

const { president } = Astro.props;
---

<article class="bg-white border border-slate-200 rounded-sm shadow-xs overflow-hidden text-center hover:border-slate-300 transition-colors duration-200 flex flex-col">
  <div class="aspect-[3/4] w-full bg-slate-100 overflow-hidden relative">
    <img
      src={president.image}
      alt={`Ritratto di ${president.name}, Presidente AIA Agrigento`}
      width="450"
      height="600"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover object-top"
      onerror="this.onerror=null;this.src='/images/avatar-placeholder.svg'"
    />
  </div>
  <div class="p-3 sm:p-4 bg-white flex flex-col flex-1 justify-center items-center">
    <h3 class="font-heading font-bold text-xs sm:text-base text-slate-900 tracking-tight leading-snug line-clamp-1">
      {president.name}
    </h3>
    <span class="font-sans text-xs text-slate-500 tabular-nums mt-1 block">
      Eletto nel {president.electedYear}
    </span>
    {president.isFounder && (
      <span class="bg-slate-100 text-slate-700 text-[10px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded-xs mt-1.5 inline-block">
        Fondatore
      </span>
    )}
    {president.isCurrent && (
      <span class="bg-blue-50 text-[#004b97] border border-blue-200 text-[10px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded-xs mt-1.5 inline-block">
        In carica
      </span>
    )}
  </div>
</article>
