---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string | URL;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const SITE_URL =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://aiaagrigento.it";
const DEFAULT_TITLE =
  "AIA Agrigento | Associazione Italiana Arbitri - Sezione di Agrigento";
const DEFAULT_DESCRIPTION =
  "Sito ufficiale dell'Associazione Italiana Arbitri (AIA) - Sezione di Agrigento FIGC. Oltre 75 anni di storia arbitrale, corsi arbitri gratuiti, designazioni, organico e il Premio Nazionale Rosario Livatino.";

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonical,
  image = "/favicon.png",
  imageAlt = "AIA Sezione di Agrigento - Associazione Italiana Arbitri FIGC",
  type = "website",
  robots = "index, follow",
  publishedTime,
  modifiedTime,
  author,
  section,
  tags = [],
  jsonLd,
} = Astro.props;

const canonicalUrl = canonical
  ? new URL(canonical.toString(), SITE_URL).toString()
  : new URL(Astro.url.pathname, SITE_URL).toString();

const ogImageUrl = image.startsWith("http")
  ? image
  : new URL(image.startsWith("/") ? image : `/${image}`, SITE_URL).toString();

const baseOrganizationSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "SportsOrganization",
  "@id": `${SITE_URL}/#organization`,
  name: "Associazione Italiana Arbitri - Sezione di Agrigento",
  alternateName: "AIA Agrigento - FIGC",
  url: SITE_URL,
  logo: `${SITE_URL}/favicon.png`,
  foundingDate: "1950",
  sport: "Calcio",
  email: "info@aiaagrigento.it",
  telephone: "+39 0922 604783",
  taxID: "93070180844",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Via Matteo Cimarra, 38",
    addressLocality: "Agrigento",
    addressRegion: "AG",
    postalCode: "92100",
    addressCountry: "IT",
  },
  sameAs: [
    "https://www.instagram.com/aia_agrigento/",
    "https://www.facebook.com/aiaagrigento",
  ],
};

const structuredDataList: Record<string, unknown>[] = [
  baseOrganizationSchema,
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#004b97" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:site_name" content="AIA Sezione di Agrigento - FIGC" />
<meta property="og:locale" content="it_IT" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={imageAlt} />

{type === "article" && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === "article" && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{type === "article" && author && (
  <meta property="article:author" content={author} />
)}
{type === "article" && section && (
  <meta property="article:section" content={section} />
)}
{type === "article" &&
  tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{structuredDataList.map((schema) => (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
))}
