---
import Layout from "@/layouts/Layout.astro";
import BlogCard from "@/components/home/BlogCard.astro";
import BlogShare from "@/components/blog/BlogShare.astro";
import { formatDateItalianLong } from "@/lib/utils/date";
import {
  getAdjacentArticles,
  getAllArticles,
  getCleanExcerpt,
  getRelatedArticles,
} from "@/lib/utils/news";
import type { Article } from "@/types/news";

export function getStaticPaths() {
  const allArticles = getAllArticles();

  return allArticles.map((article) => {
    const { prev, next } = getAdjacentArticles(article.slug);
    const relatedArticles = getRelatedArticles(article, 3);

    return {
      params: { slug: article.slug },
      props: {
        article,
        prevArticle: prev,
        nextArticle: next,
        relatedArticles,
      },
    };
  });
}

export interface Props {
  article: Article;
  prevArticle: Article | null;
  nextArticle: Article | null;
  relatedArticles: Article[];
}

const { article, prevArticle, nextArticle, relatedArticles } = Astro.props;

const formattedDateLong = formatDateItalianLong(article.pubDate);
const cleanDescription = getCleanExcerpt(article, 24).slice(0, 160);
const imageSrc = article.image || "/images/blog/fallback-news.webp";
const extraImages = article.images ?? [];
const canonicalUrl = `https://aiaagrigento.it/blog/${article.slug}`;
const authorDisplay = article.author || "Redazione AIA Agrigento";

const articleJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": ["NewsArticle", "BlogPosting"],
    "@id": `${canonicalUrl}#article`,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalUrl,
    },
    headline: article.title,
    description: cleanDescription,
    image: [imageSrc, ...extraImages].map(
      (img) => `https://aiaagrigento.it${img}`,
    ),
    datePublished: article.pubDate,
    dateModified: article.pubDate,
    articleSection: article.category,
    keywords: article.tags.join(", "),
    inLanguage: "it-IT",
    author: {
      "@type": "Organization",
      name: authorDisplay,
      url: "https://aiaagrigento.it",
    },
    publisher: {
      "@type": "SportsOrganization",
      "@id": "https://aiaagrigento.it/#organization",
      name: "Associazione Italiana Arbitri - Sezione di Agrigento",
      logo: {
        "@type": "ImageObject",
        url: "https://aiaagrigento.it/favicon.png",
      },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://aiaagrigento.it/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Blog",
        item: "https://aiaagrigento.it/blog",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.title,
        item: canonicalUrl,
      },
    ],
  },
];
---

<Layout
  title={`${article.title} | AIA Sezione di Agrigento FIGC`}
  description={cleanDescription}
  canonical={canonicalUrl}
  image={imageSrc}
  imageAlt={article.title}
  type="article"
  publishedTime={article.pubDate}
  modifiedTime={article.pubDate}
  author={authorDisplay}
  section={article.category}
  tags={article.tags}
  jsonLd={articleJsonLd}
>
  <article class="bg-white pb-16 sm:pb-24">
    <div class="border-b border-slate-100 bg-slate-50/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-3.5">
        <a
          href="/blog"
          class="group inline-flex items-center gap-2 font-heading text-xs font-semibold uppercase tracking-wider text-slate-600 hover:text-[#004b97] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004b97]"
        >
          <svg
            class="w-4 h-4 shrink-0 transition-transform duration-200 group-hover:-translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"
            />
          </svg>
          <span>Torna al blog</span>
        </a>
      </div>
    </div>

    <header class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-12 pb-6 sm:pb-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mb-4">
        <a
          href={`/blog?cat=${encodeURIComponent(article.category)}`}
          class="font-heading text-xs font-semibold uppercase tracking-wider text-[#004b97] hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004b97]"
        >
          {article.category}
        </a>
        <time
          datetime={article.pubDate}
          class="font-sans text-xs sm:text-sm text-slate-600 tabular-nums"
        >
          {formattedDateLong}
        </time>
        <span class="font-sans text-xs sm:text-sm text-slate-600">
          A cura della{" "}
          <strong class="font-semibold text-slate-800">{authorDisplay}</strong>
        </span>
      </div>

      <h1 class="font-heading font-extrabold text-2xl sm:text-4xl lg:text-5xl text-slate-900 tracking-tight leading-[1.15] text-balance">
        {article.title}
      </h1>
    </header>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-8 sm:mb-12">
      <figure class="rounded-sm overflow-hidden border border-slate-200 shadow-xs bg-slate-100">
        <img
          src={imageSrc}
          alt={article.title}
          width="1200"
          height="675"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="aspect-video w-full object-cover"
        />
      </figure>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="prose prose-slate max-w-3xl mx-auto font-sans text-base sm:text-lg text-slate-700 leading-relaxed font-normal text-pretty prose-headings:font-heading prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-slate-900 prose-p:text-slate-700 prose-p:leading-relaxed prose-strong:text-slate-900 prose-strong:font-bold prose-a:text-[#004b97] prose-a:underline prose-a:underline-offset-4 hover:prose-a:text-slate-900 prose-blockquote:border-l-4 prose-blockquote:border-referee-gold prose-blockquote:pl-4 prose-blockquote:py-1 prose-blockquote:italic prose-blockquote:text-slate-800 prose-blockquote:bg-slate-50 prose-li:text-slate-700 overflow-x-hidden"
        set:html={article.content}
      />

      {extraImages.length > 0 && (
        <div
          class:list={[
            "max-w-3xl mx-auto mt-8 sm:mt-10",
            extraImages.length >= 4
              ? "grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 items-start"
              : "space-y-6 sm:space-y-8",
          ]}
        >
          {extraImages.map((imgUrl, index) => (
            <figure class="rounded-sm overflow-hidden border border-slate-200 shadow-xs bg-slate-50">
              <img
                src={imgUrl}
                alt={`${article.title} - Immagine ${index + 2}`}
                loading="lazy"
                decoding="async"
                class="w-full h-auto block"
              />
            </figure>
          ))}
        </div>
      )}

      <BlogShare title={article.title} url={canonicalUrl} tags={article.tags} />

      {(prevArticle || nextArticle) && (
        <nav
          aria-label="Navigazione cronologica tra articoli"
          class="max-w-3xl mx-auto mt-10 pt-8 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-4"
        >
          {prevArticle ? (
            <a
              href={`/blog/${prevArticle.slug}`}
              class="group flex flex-col justify-between p-4 sm:p-5 rounded-sm border border-slate-200 bg-white hover:border-[#004b97]/50 hover:shadow-xs transition-all duration-200 text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004b97]"
            >
              <span class="font-heading text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-[#004b97] transition-colors mb-1.5">
                ← Articolo precedente
              </span>
              <span class="font-heading font-bold text-sm sm:text-base text-slate-900 group-hover:text-[#004b97] transition-colors line-clamp-2 leading-snug">
                {prevArticle.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" aria-hidden="true" />
          )}

          {nextArticle ? (
            <a
              href={`/blog/${nextArticle.slug}`}
              class="group flex flex-col justify-between p-4 sm:p-5 rounded-sm border border-slate-200 bg-white hover:border-[#004b97]/50 hover:shadow-xs transition-all duration-200 sm:text-right focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004b97]"
            >
              <span class="font-heading text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-[#004b97] transition-colors mb-1.5">
                Articolo successivo →
              </span>
              <span class="font-heading font-bold text-sm sm:text-base text-slate-900 group-hover:text-[#004b97] transition-colors line-clamp-2 leading-snug">
                {nextArticle.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" aria-hidden="true" />
          )}
        </nav>
      )}
    </div>
  </article>

  {relatedArticles.length > 0 && (
    <section
      aria-labelledby="related-articles-heading"
      class="bg-slate-50 border-t border-slate-200 py-14 sm:py-20"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-2 sm:gap-4 mb-8 sm:mb-10">
          <div
            class="h-[2px] bg-[#004b97] flex-1 min-w-5 sm:min-w-8 shrink-0"
            aria-hidden="true"
          ></div>
          <h2
            id="related-articles-heading"
            class="font-heading font-extrabold text-lg sm:text-2xl lg:text-3xl text-slate-900 tracking-tight text-balance text-center sm:whitespace-nowrap uppercase"
          >
            Altre notizie dalla Sezione
          </h2>
          <div
            class="h-[2px] bg-[#004b97] flex-1 min-w-5 sm:min-w-8 shrink-0"
            aria-hidden="true"
          ></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
          {relatedArticles.map((related) => (
            <BlogCard article={related} />
          ))}
        </div>

        <div class="mt-8 sm:mt-10 flex justify-center">
          <a
            href="/blog"
            class="w-full sm:w-auto inline-flex items-center justify-center font-heading font-bold text-xs sm:text-sm text-slate-900 border-2 border-slate-900 hover:bg-slate-900 hover:text-white active:scale-[0.98] px-6 py-3.5 min-h-[48px] rounded-sm transition-all duration-200 uppercase tracking-wider focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004b97]"
          >
            Torna a tutte le notizie
          </a>
        </div>
      </div>
    </section>
  )}
</Layout>
